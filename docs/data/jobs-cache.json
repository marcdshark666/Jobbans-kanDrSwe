      "link": "https://www.praktikertjanst.se/mer/karriar/lediga-tjanster/v%C3%A4stmanlands-l%C3%A4n/st-l%C3%A4kare/vb/790452/leg-l%C3%A4kare-s%C3%B6kes-vikariat-med-m%C3%B6jlighet-till-st-i-allm%C3%A4nmedicin",
      "stockholmMatch": true,
