      "link": "https://www.praktikertjanst.se/mer/karriar/lediga-tjanster/hallands-l%C3%A4n/specialistl%C3%A4kare/vb/884956/kattegattkliniken-s%C3%B6ker-specialistl%C3%A4kare-i-allm%C3%A4nmedicin",
      "stockholmMatch": true,
