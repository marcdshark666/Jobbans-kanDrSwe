      "title": "Överläkare till Mobila Akut och Konsultationsenheten, Psykiatri Nordväst",
      "category": "Specialist",
      "roleLabel": "Specialistläkare inom psykiatri",
      "roleSummary": "Överläkare till Mobila Akut och Konsultationsenheten, Psykiatri Nordväst",
      "location": "Danderyd",
      "employer": "Mobila Akut och Konsultationsenheten, Psykiatri Nordväst",
      "startInfo": "sker enligt överenskommelse",
