      "link": "https://www.praktikertjanst.se/mer/karriar/lediga-tjanster/stockholms-l%C3%A4n/st-l%C3%A4kare/vb/932808/st-l%C3%A4kare-i-allm%C3%A4nmedicin",
      "stockholmMatch": true,
