      "roleSummary": "Specialistläkare till Hudkliniken inom Medicinsk Specialistvård, Danderyds sjukhus",
      "location": "Danderyd",
      "employer": "Danderyds Sjukhus bedriver specialiserad öppenvård",
      "startInfo": "Enligt överenskommelse",
      "publishedAt": "2026-06-19",
      "link": "https://regionstockholm.varbi.com/se/what:job/jobID:940364/",
      "stockholmMatch": true,
