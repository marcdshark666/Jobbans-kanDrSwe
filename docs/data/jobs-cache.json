      "category": "Specialist",
      "roleLabel": "Specialistläkare inom anestesi och intensivvård",
      "roleSummary": "IT/Data Science Specialist – Intensive Care and Perioperative Data and Health Informatics",
      "location": "Stockholm",
      "employer": "Karolinska",
      "startInfo": "Enligt överenskommelse",
