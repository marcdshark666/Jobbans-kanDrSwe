      "publishedAt": "2026-06-25",
      "link": "https://www.praktikertjanst.se/mer/karriar/lediga-tjanster/norrbottens-l%C3%A4n/st-l%C3%A4kare/vb/950652/st-l%C3%A4kare-s%C3%B6kes-till-v%C3%A5rdcentralen-norra-hamn-i--lule%C3%A5!",
      "stockholmMatch": true,
