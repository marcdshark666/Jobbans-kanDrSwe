      "title": "Gustavsbergs Universitetsvårdcentral rekryterar specialist i allmänmedicin",
      "category": "Specialist",
      "roleLabel": "Specialistläkare inom allmänmedicin",
      "roleSummary": "Gustavsbergs Universitetsvårdcentral rekryterar specialist i allmänmedicin",
      "location": "Okänd ort",
      "employer": "",
      "startInfo": "efter överenskommelse",
