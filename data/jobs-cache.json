      "title": "Enhetschef till Psykiatrisk specialistmottagning Värmdö",
      "category": "Specialist",
      "roleLabel": "Specialistläkare inom psykiatri",
      "roleSummary": "Söker specialistläkare inom psykiatri med tydligt fokus på psykiatri.",
      "location": "Stockholm",
      "employer": "Psykiatrisk specialistmottagning Värmdö",
      "startInfo": "enligt överenskommelse",
      "publishedAt": "2026-07-16",
      "link": "https://regionstockholm.varbi.com/se/what:job/jobID:950430/",
      "stockholmMatch": true,
