      "link": "https://ledigajobb.se/jobb/ca7f45/underl%C3%A4kare-till-n%C3%A4rv%C3%A5rdskliniken-v%C3%A5rdcentrum-finsp%C3%A5ng",
      "stockholmMatch": false,
